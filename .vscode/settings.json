{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/**": true,
    "**/.next/**": true,
    "**/dist/**": true,
    "**/.tempmediaStorage/**": true
  },
  "search.exclude": {
    "**/node_modules": true,
    "**/.next": true,
    "**/.tempmediaStorage": true,
    "**/package-lock.json": true
  },
  "typescript.disableAutomaticTypeAcquisition": true
}